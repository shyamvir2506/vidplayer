# Local AI models — no API keys needed!
# Whisper + NLLB models auto-download on first run (~2-3 min each)
PORT=5000
FRONTEND_URL=https://your-app.vercel.app

# Translation provider: google (fast default) or nllb (fully local fallback)
TRANSLATION_PROVIDER=google

# Keep false for real dubbing quality. Set true only for troubleshooting/demo.
ALLOW_MOCK_TRANSCRIPTION=false

# fast = quicker approximate chunk timing, accurate = slower but tighter timestamps
TRANSCRIPTION_SPEED_MODE=fast

# Whisper model override and silence detection threshold for speed tuning
WHISPER_MODEL=Xenova/whisper-tiny.en
SILENCE_THRESHOLD=0.003

# Optional turbo tuning for fast mode
FAST_CHUNK_WINDOW_SECS=75
FAST_WHISPER_CHUNK_LENGTH_SECS=45
FAST_WHISPER_STRIDE_SECS=1
FAST_TARGET_SEGMENT_SECS=45
FAST_MAX_SEGMENTS_PER_CHUNK=4
FAST_MERGE_MAX_DURATION_SECS=55
FAST_MERGE_MAX_CHARS=320
TTS_SEGMENT_CONCURRENCY=6
TTS_CHUNK_CONCURRENCY=4
